{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DaperZip",
  "mainBinaryName": "DaperZip",
  "version": "0.1.0",
  "identifier": "io.github.daperzip",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "Utility",
    "shortDescription": "File archiver",
    "longDescription": "DaperZip is a file archiver powered by the 7-Zip engine.",
    "copyright": "DaperZip contributors. 7-Zip (c) Igor Pavlov.",
    "license": "MIT",
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      }
    }
  }
}
